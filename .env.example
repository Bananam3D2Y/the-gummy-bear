# Copy this file to .env and fill in the two keys. Never commit .env.

# Free keys: https://aistudio.google.com and https://console.groq.com
GEMINI_API_KEY=
GROQ_API_KEY=

# Provider order. First one that answers wins.
LLM_PROVIDERS=groq,gemini,ollama
LLM_BACKGROUND_PROVIDERS=groq,ollama,gemini

# Models
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
OLLAMA_ENABLED=1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBED_PROVIDER=ollama

# Requests per minute, kept just under the free-tier limits
GROQ_RPM=25
GEMINI_RPM=14
EMBED_RPM=60

# Local services
KAFKA_BROKERS=localhost:9092
REDIS_ADDR=localhost:6379
LORE_DIR=lore
CAST_PATH=../cast.json
