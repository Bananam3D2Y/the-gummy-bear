# Copy to .env and fill in at least one key. Never commit .env.

# ---- LLM providers (tried in LLM_PROVIDERS order; a 429 falls through to the next)
GEMINI_API_KEY=
GROQ_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_ENABLED=1

LLM_PROVIDERS=gemini,groq,openrouter,ollama

# Model names change often. Check each provider's console for current free models.
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
GROQ_MODEL=llama-3.1-8b-instant
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Requests per minute you allow yourself. Keep these BELOW each free tier's limit.
GEMINI_RPM=12
GROQ_RPM=25
EMBED_RPM=60

# ---- RAG: which provider creates embeddings (gemini or ollama)
EMBED_PROVIDER=gemini

# ---- Addresses (defaults work when running on your machine)
KAFKA_BROKERS=localhost:9092
REDIS_ADDR=localhost:6379
LORE_DIR=lore
